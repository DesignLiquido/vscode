{
    "name": "designliquido-vscode",
    "displayName": "Design Líquido - Linguagens em Português",
    "description": "Extensão de sintaxe para o Visual Studio Code nas linguagens da Design Líquido: Delégua, LMHT, FolEs, LinConEs, dialetos de Portugol (VisuAlg, Portugol Studio, Mapler) e outras linguagens de programação em português.",
    "icon": "recursos/icone.png",
    "publisher": "designliquido",
    "repository": {
        "type": "git",
        "url": "https://github.com/DesignLiquido/vscode"
    },
    "version": "0.27.1",
    "engines": {
        "vscode": "^1.80.0"
    },
    "browser": "./dist/extensao-web.js",
    "main": "./dist/extensao.js",
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "capabilities": {
        "virtualWorkspaces": true,
        "untrustedWorkspaces": {
            "supported": true
        }
    },
    "keywords": [
        "delegua",
        "birl",
        "visualg",
        "egua",
        "lmht",
        "mapler",
        "foles",
        "lincones",
        "portugol",
        "potigol",
        "tradutor",
        "portuguese",
        "português",
        "pitugues",
        "pituguês"
    ],
    "categories": [
        "Debuggers",
        "Education",
        "Formatters",
        "Language Packs",
        "Linters",
        "Programming Languages",
        "Snippets"
    ],
    "author": "Leonel Sanches da Silva",
    "contributors": [
        {
            "name": "Leonel Sanches da Silva",
            "url": "https://www.linkedin.com/in/leonelsanchesdasilva/"
        },
        {
            "name": "Samuel Renan Gonçalves Vaz",
            "url": "https://www.linkedin.com/in/samuel-renan-goncalves-vaz/"
        }
    ],
    "bugs": {
        "url": "https://github.com/DesignLiquido/vscode/issues"
    },
    "scripts": {
        "compilar": "tsc -p ./",
        "lint": "yarn eslint depuracao --ext ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "build-base": "esbuild ./fontes/extensao.ts --bundle --sources-content=true --tsconfig=./tsconfig.json --external:vscode --format=cjs --platform=node --outfile=dist/extensao.js",
        "build-continuo": "npm run -S build-base -- --sourcemap --watch",
        "compilar-web": "webpack --mode development",
        "watch-web": "webpack --mode development --watch",
        "montar": "npm run -S build-base -- --sourcemap --sources-content=true && npm run -S build-web -- --sourcemap",
        "empacotar": "yarn build-base && yarn pre-empacotar-web && yarn copy-files-from-to && yarn vsce package --yarn",
        "pre-empacotar-web": "webpack --mode production --devtool hidden-source-map",
        "publicar": "yarn vsce publish",
        "publicar-pre-lancamento": "vsce publish --pre-release",
        "vscode:pre-publicar": "rimraf dist && npm run -S build-base -- --minify && npm run -S build-web -- --minify",
        "testar-tipagem": "yarn typecheck",
        "testes-unitarios": "jest --coverage",
        "testes-unitarios:continuo": "jest --watch",
        "testes-unitarios:verboso": "jest --verbose",
        "testar-web": "yarn compilar-web && vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
        "vscode:pre-empacotar-web": "yarn pre-empacotar"
    },
    "activationEvents": [
        "onDebugResolve:designliquido",
        "onDebugDynamicConfigurations:designliquido",
        "onCommand:extension.designliquido.getProgramName",
        "onCommand:extension.designliquido.runEditorContents",
        "onCommand:extension.designliquido.debugEditorContents"
    ],
    "workspaceTrust": {
        "request": "never"
    },
