        "configuration": {
            "title": "Design Líquido",
            "properties": {
                "delegua.estilizador.habilitado": {
                    "type": "boolean",
                    "default": true,
                    "description": "Habilitar ou desabilitar o Estilizador durante a formatação de código."
                },
                "delegua.estilizador.fortalecerTipos.habilitado": {
                    "type": "boolean",
                    "default": false,
                    "description": "Habilitar regra de fortalecimento de tipos. Converte declarações com tipo 'qualquer' para tipos inferidos (número, texto, lógico, etc.)."
                },
                "delegua.estilizador.explicitarTiposParametros.habilitado": {
                    "type": "boolean",
                    "default": false,
                    "description": "Habilitar regra de explicitação de tipos em parâmetros sem anotação. Materializa ': qualquer' em parâmetros de função e método."
                },
                "delegua.estilizador.convencaoNomenclatura.habilitado": {
                    "type": "boolean",
                    "default": false,
                    "description": "Habilitar regra de convenção de nomenclatura para identificadores."
                },
                "delegua.estilizador.convencaoNomenclatura.variaveis": {
                    "type": "string",
                    "enum": [
                        "caixaCamelo",
                        "caixa_cobra",
                        "CaixaPascal"
                    ],
                    "enumDescriptions": [
                        "caixaCamelo - primeira palavra minúscula, demais capitalizadas (ex: minhaVariavel)",
                        "caixa_cobra - palavras separadas por underscore em minúsculas (ex: minha_variavel)",
                        "CaixaPascal - todas as palavras capitalizadas (ex: MinhaVariavel)"
                    ],
                    "default": "caixaCamelo",
                    "description": "Convenção de nomenclatura para variáveis."
                },
                "delegua.estilizador.convencaoNomenclatura.constantes": {
                    "type": "string",
                    "enum": [
                        "CAIXA_ALTA",
                        "caixaCamelo"
                    ],
                    "enumDescriptions": [
                        "CAIXA_ALTA - todas as letras maiúsculas separadas por underscore (ex: MINHA_CONSTANTE)",
                        "caixaCamelo - primeira palavra minúscula, demais capitalizadas (ex: minhaConstante)"
                    ],
                    "default": "CAIXA_ALTA",
                    "description": "Convenção de nomenclatura para constantes."
                },
                "delegua.estilizador.convencaoNomenclatura.funcoes": {
                    "type": "string",
                    "enum": [
                        "caixaCamelo",
                        "caixa_cobra",
                        "CaixaPascal"
                    ],
                    "enumDescriptions": [
                        "camelCase - primeira palavra minúscula, demais capitalizadas (ex: minhaFuncao)",
                        "snake_case - palavras separadas por underscore em minúsculas (ex: minha_funcao)",
                        "PascalCase - todas as palavras capitalizadas (ex: MinhaFuncao)"
                    ],
                    "default": "caixaCamelo",
                    "description": "Convenção de nomenclatura para funções."
                },
                "delegua.estilizador.delimitadorTexto": {
                    "type": "string",
                    "enum": [
                        "aspas-simples",
                        "aspas-duplas",
                        "preservar"
                    ],
                    "enumDescriptions": [
                        "Sempre usar aspas simples para literais de texto (ex: 'olá')",
