{
	"Repetição Para": {
		"prefix": "para",
		"body": [
			"para (var ${1:i} = 0; ${1:i} < ${2:5}; ${1:i} = ${1:i} + 1) {",
			"\t${3:escreva(${1:i})};",
			"}"
		],
		"description": "Laço de repetição \"para\""
	},
	"Repetição Fazer Enquanto": {
		"prefix": "fazer enquanto",
		"body": [
			"var i = 0;",
			"fazer { ",
			"\t${1:escreva(i)};",
			"\ti = i + 1;",
			"} enquanto(i < ${2:5})"
		],
		"description": "Laço de repetição \"fazer-enquanto\""
	},
	"Declaração de Funcao Padrão": {
		"prefix": "funcao padrao",
