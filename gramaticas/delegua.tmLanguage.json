{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Delegua",
	"patterns": [
		{ "include": "#keywords" },
		{ "include": "#functions" },
		{ "include": "#constants" },
		{ "include": "#numbers" },
		{ "include": "#logical" },
		{ "include": "#types" },
		{ "include": "#comments" },
		{ "include": "#arithmetic" },
		{ "include": "#assignments" },
		{ "include": "#comparison" },
		{ "include": "#strings" },
		{ "include": "#storages" },
		{ "include": "#identifiers" }
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.delegua",
					"match": "\\b(cada|caso|como|const|constante|continua|continuar|de|enquanto|escolha|falhar|fazer|fa[cç]a|finalmente|fixo|fun[cç][aã]o|import[ae]|importar|padr[aã]o|para|pegue|quebrar|quebre|retorna|retorne|retornar|se|sen[aã]o|sustar|tente|tendo|tentar|tipo|tudo|var|vari[aá]vel)\\b"
				},
				{
					"name": "keyword.other.delegua",
					"match": "\\b(abstrat[ao]|classe|construtor|est[aá]tic[ao]|extens[aã]o|herda|implementa|interface|isto|mescla|operador|privado|protegido|p[uú]blico|super)\\b"
				}
			]
		},
		"functions": {
			"patterns": [{
				"name": "keyword.function.delegua",
				"match": "\\b(aleatorio|aleatorioEntre|escreva|inteiro|intervalo|leia|mapear|ordenar|real|tamanho|texto|importar|ajuda|exemplo|limpar|salvar|carregar|fun1|fun1R|ajuda|exemplo|limpar|salvar|carregar|fun1|fun1R|linspace|fun2|fun2R|rand|aprox|pale|vet|qtd|plot|max|min|intervalo|mediana|smtr|media|ve|sqr|variancia|devpad|covar|coefvar|coefcorr|coluna|linha|transposta|matriz|matrizmult|matrizinv|matrizid|deter|csl|sen|cos|tan|arcos|arsen|artan|exp|log|pot|aleat|raizq|vmed|deltas|deltat|acel|mrufh|mrufhp|mruvel|mruvfh|mruvfhp|mruvvel|mruvvelp|inercia|vmmv|van|periodo|pid)\\b"
			}]
		},
		"constants": {
			"patterns": [{
				"name": "constant.language.delegua",
				"match": "\\b(falso|verdadeiro|isto|nulo)\\b"
			}]
		},
		"numbers": {
			"name": "constant.numeric",
			"match": "\\b[0-9]+(\\.[0-9]+)?\\b"
		},
		"logical": {
			"patterns": [{
				"name": "keyword.operator.logical.delegua",
				"match": "\\b(e|ou|em|n[aã]o|cont[eé]m)\\b"
			}]
		},
		"types": {
			"patterns": [{
				"name": "storage.type.primitive.delegua",
				"match": "\\b(dicion[aá]rio|inteiro|l[oó]gico|longo|m[oó]dulo|n[uú]mero|objeto|real|vetor|texto)\\b"
			}]
		},
		"comments": {
			"patterns": [
				{
					"begin": "/\\*\\*(?!/)",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.delegua"
						}
					},
					"end": "\\*/",
					"name": "comment.block.documentation.delegua"
				},
				{
					"begin": "/\\*",
					"captures": {
						"0": {
							"name": "punctuation.definition.comment.delegua"
						}
					},
					"end": "\\*/",
					"name": "comment.block.delegua"
				},
				{
					"captures": {
						"1": {
							"name": "punctuation.definition.comment.delegua"
						}
					},
					"match": "(//).*$\\n?",
					"name": "comment.line.double-slash.delegua"
				}
			]
		},
		"arithmetic": {
			"patterns": [{
				"name": "keyword.operator.arithmetic.delegua",
				"match": "\\b(\\+|\\-|\\*|/|mod|div|\\:\\:)\\b"
			}]
		},
		"assignments": {
			"patterns": [{
				"name": "keyword.operator.assignment.delegua",
				"match": "\\b(\\=|\\:=)\\b"
			}]
		},
		"comparison": {
			"patterns": [{
				"name": "keyword.operator.comparison.delegua",
				"match": "\\b(<\\=|>\\=|\\=\\=|<|>|\\<\\>)\\b"
			}]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.single.delegua",
					"begin": "\\'",
					"end": "\\'",
					"patterns": [
						{
							"name": "constant.character.escape.delegua",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.double.delegua",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.delegua",
							"match": "\\\\."
						}
					]
			}]
		},
		"storages": {
			"patterns": [
				{
					"name": "storage.type.swift",
					"match": "\\b(classe|construtor)\\b"
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"name": "entity.other.attribute-name",
					"match": "(\\b(super)\\b)|#[_a-zA-Z0-9]+"
				},
				{
					"name": "entity.name.type.interface",
					"match": "((?<=interface\\s)|(?<=implementa\\s))([_a-zA-Z0-9]+)"
				},
				{
					"name": "entity.name.type.class",
					"match": "((?<=classe\\s)|(?<=herda\\s)|(?<=mescla\\s))([_a-zA-Z0-9]+)"
				},
				{
					"name":  "entity.name.function",
					"match": "([_a-zA-Z0-9]+)(?=[ ]*[=][ ]*(\\(|funcao))"
				},
				{
					"name":  "variable.parameter",
					"match": "([_a-zA-Z0-9]+)(?=[ ]*[=])"
				},
				{
					"name":  "entity.other.attribute-name",
					"match": "([_a-zA-Z0-9]+)(?=[ ]*[:])"
				},
				{
					"name": "entity.name.function",
					"match": "([_a-zA-Z0-9]+)(?=([\\s]*\\())"
				},
				{
					"name": "variable.language",
					"match": "[_a-zA-Z0-9]+"
				}
			]
		}
	},
	"scopeName": "source.delegua"
}