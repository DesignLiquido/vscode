{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "delprops",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#booleans" },
		{ "include": "#namespace-conhecido" },
		{ "include": "#strings" },
		{ "include": "#numbers" },
		{ "include": "#operators" },
		{ "include": "#property-path" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"captures": {
						"1": { "name": "punctuation.definition.comment.delprops" }
					},
					"match": "(//).*$\\n?",
					"name": "comment.line.double-slash.delprops"
				}
			]
		},
		"booleans": {
			"patterns": [
				{
					"name": "constant.language.delprops",
					"match": "\\b(verdadeiro|falso)\\b"
				}
			]
		},
		"namespace-conhecido": {
			"patterns": [
				{
					"name": "entity.name.namespace.delprops",
					"match": "^\\s*\\b(liquido)\\b(?=\\.)"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.single.delprops",
					"begin": "\\'",
					"end": "\\'",
					"patterns": [
						{
							"name": "constant.character.escape.delprops",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.double.delprops",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.delprops",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"numbers": {
			"name": "constant.numeric",
			"match": "\\b[0-9]+(\\.[0-9]+)?\\b"
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.delprops",
					"match": "="
				}
			]
		},
		"property-path": {
			"patterns": [
				{
					"name": "variable.other.property.delprops",
					"match": "\\b[\\w]+\\b"
				}
			]
		}
	},
	"scopeName": "source.delprops"
}
